{
  "name": "@tricking/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo ok",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed/seed.ts",
    "db:map": "tsx src/seed/map-loopkicks.ts",
    "db:relations": "tsx src/seed/trick-relations.ts",
    "db:difficulty": "tsx src/seed/apply-difficulty.ts",
    "db:variations": "tsx src/seed/variations.ts",
    "db:transitions": "tsx src/seed/transitions.ts",
    "db:stances": "tsx src/seed/stances.ts",
    "db:stance-links": "tsx src/seed/stance-links.ts",
    "db:translations": "tsx src/seed/apply-translations.ts",
    "db:how-to": "tsx src/seed/apply-how-to.ts",
    "db:loopkicks-notes": "tsx src/seed/loopkicks-notes.ts",
    "db:tutorials": "tsx src/seed/tutorials.ts",
    "db:videos": "tsx src/seed/videos.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@trickingapi/tricks-core-data": "^0.1.3",
    "@trickingapi/tricking-ts": "^0.1.4",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
