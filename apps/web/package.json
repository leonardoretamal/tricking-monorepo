    "@tricking/ui": "workspace:*",
    "@upstash/redis": "^1.39.0",
    "daisyui": "^5.7.47",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "pino": "^9.14.0",
