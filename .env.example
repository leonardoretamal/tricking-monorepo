# =============================================================================
# Variables de entorno del monorepo.
# Copia este archivo a .env y completa los valores reales.
# Los valores de ejemplo no son reales. El .env real nunca se versiona.
# =============================================================================

# --- Base de datos (Fase 1) ---

# Cadena pooled de Neon (el host termina en -pooler).
# La usa la aplicacion en runtime. El pooler reutiliza conexiones para no agotar
# el limite de Postgres en entornos serverless.
DATABASE_URL="postgresql://usuario:change-me@ep-xxxx-pooler.region.aws.neon.tech/tricking?sslmode=require"

# Cadena directa de Neon (sin -pooler).
# La usa drizzle-kit para db:generate y db:migrate. Las migraciones necesitan una
# conexion directa porque el pooler no maneja bien las sentencias DDL de larga duracion.
DATABASE_URL_UNPOOLED="postgresql://usuario:change-me@ep-xxxx.region.aws.neon.tech/tricking?sslmode=require"

# NEON_BRANCH lo inyecta la CLI de Neon (neon env pull / neon link), no lo lee la
# aplicacion. Se documenta por si aparece en el .env local; no hace falta definirlo a mano.
# NEON_BRANCH="production"

# --- Logging (Fase 3) ---

# Nivel minimo de log de Pino (fatal, error, warn, info, debug, trace).
# Opcional. Si no se define, la aplicacion usa "info".
LOG_LEVEL="info"

# --- Almacenamiento de videos en Cloudflare R2 (Fase 14, RESERVADO) ---

# R2 queda reservado para videos propios o con licencia. Los videos de Loopkicks NO se
# re-hospedan (cada truco enlaza al original). El script upload:videos se niega a correr
# salvo que se pase --confirm-rights.

# Cuenta de Cloudflare R2. El endpoint del cliente S3 es
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="change-me"

# Credenciales de API de R2 (token de acceso con permiso de escritura sobre el bucket).
# Solo las usan los scripts del scraper; nunca se exponen al frontend.
R2_ACCESS_KEY_ID="change-me"
R2_SECRET_ACCESS_KEY="change-me"

# Nombre del bucket donde viven los videos.
R2_BUCKET="tricking-videos"

# Dominio publico del bucket (o dominio personalizado) para construir la URL de reproduccion.
# Ejemplo: https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- Cola y cache con Upstash (Fase 13, RESERVADAS) ---
# La Fase 13 usa la API publica de kojostricklab.com y no necesita esta cola. Estas
# variables y el worker de Instagram (insta-fetcher + QStash) quedan reservados como
# respaldo opcional; no se leen hasta que se active ese worker.

UPSTASH_REDIS_REST_URL="https://change-me.upstash.io"
UPSTASH_REDIS_REST_TOKEN="change-me"
QSTASH_TOKEN="change-me"

# URL publica del endpoint que disparara el worker de Kojo (QStash le hace POST).
# Reservada: la ruta no existe todavia.
KOJO_WORKER_URL="http://localhost:3000/api/kojo/run"

# --- ffmpeg (Fase 14, herramienta del sistema) ---

# Ruta al binario de ffmpeg si no esta en el PATH. Opcional; por defecto "ffmpeg".
FFMPEG_PATH="ffmpeg"

# Limite opcional de trucos a procesar al scrapear videos de Loopkicks. 0 o vacio
# procesa todos. Util para pruebas locales.
VIDEO_SCRAPE_LIMIT="0"

# =============================================================================
# Variables de fases futuras. Aun NO se activan; se agregan cuando su fase las
# necesite y quedan documentadas en docs/docs-agents/stack-tecnico.md.
# =============================================================================
# Fase 18 (feedback de usuarios) ahora SI se activa:
#
# API key de Resend (https://resend.com/api-keys). Solo se usa en el servidor.
RESEND_API_KEY="change-me"

# Direccion que recibe el aviso de cada feedback nuevo.
FEEDBACK_NOTIFY_EMAIL="change-me@example.com"

# Remitente de los avisos. Debe pertenecer a un dominio verificado en Resend.
FEEDBACK_FROM_EMAIL="feedback@example.com"

# Token que protege el panel /admin/feedback (se envia en la cabecera
# `x-feedback-admin-token`). El valor real vive solo en el .env local (no
# versionado); aqui va un placeholder.
FEEDBACK_ADMIN_TOKEN="change-me"

# Claves de Cloudflare Turnstile para el captcha del formulario de feedback.
# La site key es publica (va al navegador); la secret key es privada.
# https://developers.cloudflare.com/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY="change-me"
TURNSTILE_SECRET_KEY="change-me"

# --- SEO tecnico (Fase 19) ---

# URL publica absoluta del sitio, sin barra final. Base de las URLs canonicas,
# Open Graph, Twitter Cards, sitemap.xml y hreflang.
# En produccion: https://tudominio.com. En desarrollo: http://localhost:3000.
# Opcional; si no se define, se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Codigo de verificacion de Google Search Console (meta tag). Opcional; la
# verificacion tambien puede hacerse por DNS sin esta variable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="change-me"

# --- Asistente de IA y combinaciones (Fase 22) ---
#
# El asistente prueba los proveedores configurados EN ORDEN y usa el primero que
# responde; si uno falla o agota su cuota, cae al siguiente. Todos son endpoints
# compatibles con OpenAI y se llaman por HTTP, sin SDK de proveedor. Solo el servidor lee
# las keys. El nombre del proveedor que responde se muestra en el chat.
#
# Solo proveedores gratuitos. Se excluyeron Google Gemini (el usuario lo usa en otro
# repo), Cerebras y Mistral (cobran).
#
# Groq (free, sin tarjeta): key en https://console.groq.com/keys
AI_GROQ_API_KEY="change-me"
# NVIDIA NIM (creditos gratis): key en https://build.nvidia.com
AI_NVIDIA_API_KEY="change-me"
# OpenRouter: cobra si el modelo no es gratuito. El codigo solo lo usa con modelos que
# terminan en ":free" (candado anti-cobro). Los ids free rotan seguido; verifica con
# https://openrouter.ai/models?max_price=0 . key en https://openrouter.ai/keys
AI_OPENROUTER_API_KEY="change-me"


# Orden de intento opcional. Ids: groq, nvidia, openrouter.
# Si se omite, se usa el orden de arriba. Ejemplo:
# AI_PROVIDER_ORDER="groq,nvidia,openrouter"

# Modelo opcional por proveedor (si se omite se usa el default del codigo).
# AI_GROQ_MODEL="openai/gpt-oss-120b"
# AI_NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
# OpenRouter: el id debe terminar en ":free".
# AI_OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Endpoint opcional por proveedor (solo si el proveedor cambia de URL).
# AI_GROQ_BASE_URL="https://api.groq.com/openai/v1"
# AI_NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# AI_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Tope diario de peticiones con IA POR PROVEEDOR (ademas del rate limit por IP). El total
# diario es la suma: con 3 proveedores y 200 cada uno, hasta 600 peticiones por dia.
# Opcional; por defecto 200 por proveedor.
AI_DAILY_REQUEST_CAP="200"

# Proveedor propio opcional (compatibilidad con un unico endpoint compatible OpenAI).
# AI_PROVIDER_NAME="Proveedor propio"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
# AI_API_KEY="change-me"
