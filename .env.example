# =============================================================================
# Variables de entorno del monorepo.
# Copia este archivo a .env y completa los valores reales.
# Los valores de ejemplo no son reales. El .env real nunca se versiona.
# =============================================================================

# --- Base de datos (Fase 1) ---

# Cadena pooled de Neon (el host termina en -pooler).
# La usa la aplicacion en runtime. El pooler reutiliza conexiones para no agotar
# el limite de Postgres en entornos serverless.
DATABASE_URL="postgresql://usuario:change-me@ep-xxxx-pooler.region.aws.neon.tech/tricking?sslmode=require"

# Cadena directa de Neon (sin -pooler).
# La usa drizzle-kit para db:generate y db:migrate. Las migraciones necesitan una
# conexion directa porque el pooler no maneja bien las sentencias DDL de larga duracion.
DATABASE_URL_UNPOOLED="postgresql://usuario:change-me@ep-xxxx.region.aws.neon.tech/tricking?sslmode=require"

# =============================================================================
# Variables de fases futuras. Aun NO se activan; se agregan cuando su fase las
# necesite y quedan documentadas en docs/docs-agents/stack-tecnico.md.
# =============================================================================
# Fase 13 y 14 (videos en Cloudflare R2):
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_URL
# Fase 13 y 2 (cola y cache con Upstash):
# UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN, QSTASH_TOKEN
# Fase 18 (correo con Resend):
# RESEND_API_KEY, FEEDBACK_NOTIFY_EMAIL, FEEDBACK_FROM_EMAIL
