#!/usr/bin/env bash
# lupe-start - unified launcher for Claude Code and opencode.
# Boots headroom proxy (and ruflo swarm for Claude Code), then opens the chosen tool.
# All tool flags are forwarded transparently.
#
# TOOL (anywhere in args - default: claude)
#   claude    Claude Code + ruflo swarm
#   opencode  opencode  (alias: oc)
#
# PRESETS (anywhere in args - default: dev)
#   dev   · high effort · continue last session
#   plan  · max effort  · new named session      (GSD planning)
#   exec  · fast model  · continue last session  (GSD execution)
#
# HEADROOM
#   All traffic is forced through the local headroom proxy (http://localhost:8787)
#   for 60-95% token compression. Sourcing ~/.headroom.env auto-starts the proxy.
#   Override with --no-headroom (emergency bypass - prints a warning).
#
# USAGE
#   lupe-start                         claude · dev · current dir
#   lupe-start opencode                opencode · dev · current dir
#   lupe-start plan                    claude · plan · current dir
#   lupe-start opencode plan           opencode · plan · current dir
#   lupe-start plan /path/to/proj      claude · plan · explicit dir
#   lupe-start opencode exec /path     all three, any order
#   lupe-start exec --verbose          preset + extra tool flags
#   lupe-start --fresh                 drop -c; start with clean context
#   lupe-start --graph                 refresh knowledge graph before launch
#   lupe-start --status                show ruflo swarm status (claude only)
#   lupe-start --headroom-status       show headroom proxy status
#   lupe-start --no-headroom           bypass headroom proxy
#   lupe-start -h, --help              show this help
set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
RESET='\033[0m'

# ── Tool + preset classification ──────────────────────────────────────────────
is_tool()   { [[ "$1" == claude || "$1" == opencode || "$1" == oc ]]; }
is_preset() { [[ "$1" == dev || "$1" == plan || "$1" == exec ]]; }

normalize_tool() { [[ "$1" == oc ]] && echo opencode || echo "$1"; }

preset_flags() {
  local tool="$1" preset="$2"
  case "${tool}:${preset}" in
    claude:dev)       echo "--permission-mode bypassPermissions --model opus --effort high --ide -c" ;;
    claude:plan)      echo "--permission-mode bypassPermissions --model opus --effort max --ide" ;;
    claude:exec)      echo "--permission-mode bypassPermissions --model sonnet --effort high --ide -c" ;;
    opencode:dev)     echo "-m opencode/claude-opus-4-8 -c" ;;
    opencode:plan)    echo "-m opencode/claude-opus-4-8" ;;
    opencode:exec)    echo "-m opencode/claude-sonnet-4-6 -c" ;;
    *) echo "" ;;
  esac
}

preset_label() {
  local tool="$1" preset="$2"
  case "${tool}:${preset}" in
    claude:dev)       echo "opus · high · bypassPerms · continue" ;;
    claude:plan)      echo "opus · max effort · named session" ;;
    claude:exec)      echo "sonnet · high · bypassPerms · continue" ;;
    opencode:dev)     echo "opus-4-8 · continue" ;;
    opencode:plan)    echo "opus-4-8 · named session" ;;
    opencode:exec)    echo "sonnet-4-6 · continue" ;;
    *) echo "" ;;
  esac
}

# ── Shared headroom helpers ───────────────────────────────────────────────────
headroom_status() {
  if [[ -f "$HOME/.headroom.env" ]] && headroom-status >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    ( source "$HOME/.headroom.env" >/dev/null 2>&1; headroom-status )
  elif command -v headroom >/dev/null 2>&1; then
    PORT="${HEADROOM_PORT:-8787}"
    curl -fsS "http://localhost:${PORT}/livez" && echo " (healthy)" \
      || echo "headroom proxy not reachable on :${PORT}"
  else
    echo "headroom not installed - run: pipx install \"headroom-ai[all]\"" >&2
    exit 1
  fi
}

headroom_enforce() {
  if [[ -f "$HOME/.headroom.env" ]]; then
    # shellcheck disable=SC1090,SC1091
    source "$HOME/.headroom.env" >/dev/null 2>&1
  fi
  if ! command -v headroom >/dev/null 2>&1; then
    echo -e "${YELLOW}✗ 'headroom' not on PATH - install with: pipx install \"headroom-ai[all]\"${RESET}" >&2
    echo -e "${YELLOW}  (or rerun with --no-headroom to bypass)${RESET}" >&2
    exit 1
  fi
  if command -v headroom-start >/dev/null 2>&1; then
    headroom-start >/dev/null 2>&1 || true
  fi
  HEADROOM_PORT="${HEADROOM_PORT:-8787}"
  if ! curl -fsS "http://localhost:${HEADROOM_PORT}/livez" >/dev/null 2>&1; then
    echo -e "${YELLOW}✗ headroom proxy not reachable on :${HEADROOM_PORT} - aborting${RESET}" >&2
    echo -e "${YELLOW}  (run 'lupe-start --headroom-status' to debug, or --no-headroom to bypass)${RESET}" >&2
    exit 1
  fi
  export ANTHROPIC_BASE_URL="http://localhost:${HEADROOM_PORT}"
  export OPENAI_BASE_URL="http://localhost:${HEADROOM_PORT}/v1"
  HEADROOM_URL="$ANTHROPIC_BASE_URL"
}

# ── First pass: early-exit flags (position-independent, stops at --) ──────────
NO_HEADROOM=0
FRESH=0
GRAPH=0
DO_STATUS=0
for arg in "$@"; do
  [[ "$arg" == "--" ]] && break   # everything after -- passes through verbatim
  case "$arg" in
    --no-headroom)     NO_HEADROOM=1 ;;
    --fresh)           FRESH=1 ;;
    --graph)           GRAPH=1 ;;
    --status)          DO_STATUS=1 ;;
    --headroom-status) headroom_status; exit 0 ;;
    -h|--help)
      tail -n +2 "$0" | awk '/^[^#]/{exit} {sub(/^# ?/,""); print}'
      exit 0 ;;
  esac
done

# ── Main arg parse ────────────────────────────────────────────────────────────
# USER_ARGS collects only what the user explicitly typed - shown in the header.
# The preset flags are tracked separately so the header doesn't expose internals.
USER_ARGS=()
PROJECT_DIR=""
PRESET=""
TOOL=""

PASSTHROUGH_MODE=0
for arg in "$@"; do
  if [[ $PASSTHROUGH_MODE -eq 1 ]]; then
    USER_ARGS+=("$arg")
    continue
  fi
  if [[ "$arg" == "--" ]]; then
    PASSTHROUGH_MODE=1
    continue
  fi
  [[ "$arg" == "--no-headroom" || "$arg" == "--fresh" || "$arg" == "--graph" ]] && continue

  if is_tool "$arg"; then
    TOOL="$(normalize_tool "$arg")"
  elif is_preset "$arg"; then
    PRESET="$arg"
  elif [[ -z "$PROJECT_DIR" && ! "$arg" == --* && ! "$arg" == -* && -d "$arg" ]]; then
    PROJECT_DIR="$arg"
  else
    USER_ARGS+=("$arg")
  fi
done

TOOL="${TOOL:-claude}"
PRESET="${PRESET:-dev}"
PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"

# ── Tool-aware --status (resolved after TOOL is known) ────────────────────────
if [[ $DO_STATUS -eq 1 ]]; then
  if [[ "$TOOL" == claude ]]; then
    command -v ruflo >/dev/null 2>&1 || { echo -e "${YELLOW}✗ ruflo not found${RESET}" >&2; exit 1; }
    ruflo status
  else
    echo -e "${YELLOW}⚠ --status shows ruflo swarm status (claude only)${RESET}" >&2
    echo -e "${DIM}  For opencode session info: opencode --help${RESET}" >&2
  fi
  exit 0
fi

# ── Preset expansion ──────────────────────────────────────────────────────────
IFS=' ' read -ra PRESET_EXPANDED <<< "$(preset_flags "$TOOL" "$PRESET")" || true

# --fresh: strip -c from preset to force a clean context window
if [[ $FRESH -eq 1 ]]; then
  FILTERED=()
  for f in "${PRESET_EXPANDED[@]+"${PRESET_EXPANDED[@]}"}"; do
    [[ "$f" == "-c" ]] && continue
    FILTERED+=("$f")
  done
  PRESET_EXPANDED=("${FILTERED[@]+"${FILTERED[@]}"}")
fi

# plan: auto-name the session - MMDD-HHMM avoids same-day collisions
if [[ "$PRESET" == "plan" ]]; then
  SESSION_NAME="$(basename "$PROJECT_DIR")-$(date +%m%d-%H%M)"
  NAME_FLAG="$( [[ "$TOOL" == claude ]] && echo "--name" || echo "--title" )"
  if ! printf '%s\n' "${USER_ARGS[@]+"${USER_ARGS[@]}"}" | grep -q -- "^${NAME_FLAG}$"; then
    USER_ARGS+=("$NAME_FLAG" "$SESSION_NAME")
  fi
fi

# ── Header (printed before graphify so the user knows what's launching) ───────
TOOL_LABEL="$( [[ "$TOOL" == claude ]] && echo "Claude Code" || echo "opencode" )"
echo -e "${CYAN}◆ lupe-start → ${TOOL_LABEL}${RESET}"
echo -e "${DIM}  project: $PROJECT_DIR${RESET}"
PRESET_DESC="$(preset_label "$TOOL" "$PRESET")"
[[ $FRESH -eq 1 ]] && PRESET_DESC="${PRESET_DESC} · fresh"
[[ $GRAPH -eq 1 ]] && PRESET_DESC="${PRESET_DESC} · graph"
echo -e "${DIM}  preset:  ${PRESET} - ${PRESET_DESC}${RESET}"
# Only show flags the user explicitly typed, not preset internals
[[ ${#USER_ARGS[@]} -gt 0 ]] && echo -e "${DIM}  flags:   ${USER_ARGS[*]}${RESET}"
echo ""

# ── Preflight: required tool on PATH ─────────────────────────────────────────
command -v "$TOOL" >/dev/null 2>&1 || {
  echo -e "${YELLOW}✗ '$TOOL' not found on PATH - aborting${RESET}"; exit 1; }

# ── Combine preset + user flags into final arg list ───────────────────────────
TOOL_ARGS=(
  "${PRESET_EXPANDED[@]+"${PRESET_EXPANDED[@]}"}"
  "${USER_ARGS[@]+"${USER_ARGS[@]}"}"
)

# ── Headroom proxy ────────────────────────────────────────────────────────────
HEADROOM_URL=""
if [[ $NO_HEADROOM -eq 0 ]]; then
  headroom_enforce
else
  echo -e "${YELLOW}⚠ --no-headroom: bypassing proxy (no compression)${RESET}" >&2
  unset ANTHROPIC_BASE_URL OPENAI_BASE_URL
fi

cd "$PROJECT_DIR"

# ── Claude-only: ruflo bootstrap + available services ─────────────────────────
if [[ "$TOOL" == claude ]]; then
  command -v ruflo >/dev/null 2>&1 || {
    echo -e "${YELLOW}✗ 'ruflo' not found on PATH - aborting${RESET}"; exit 1; }

  if [[ ! -d "$PROJECT_DIR/.claude-flow" ]]; then
    echo -e "${YELLOW}▶ Initializing ruflo in project...${RESET}"
    if ruflo init >/dev/null 2>&1 && [[ -d "$PROJECT_DIR/.claude-flow" ]]; then
      echo -e "${GREEN}✓ ruflo initialized${RESET}"
    else
      echo -e "${YELLOW}⚠ ruflo init failed - continuing without swarm${RESET}"
    fi
  fi

  echo -e "${YELLOW}▶ Starting ruflo daemon + swarm (best-effort)...${RESET}"
  ruflo start --daemon >/dev/null 2>&1 &
  echo -e "${GREEN}✓ ruflo daemon launch issued (swarm: hierarchical-mesh)${RESET}"
  echo -e "${GREEN}✓ MCP server: managed by Claude Code (registered in ~/.claude.json)${RESET}"

  echo ""
  echo -e "${DIM}  Available this session:${RESET}"
  echo -e "${DIM}  • Swarm agents  (mcp__claude-flow__swarm_init, agent_spawn, ...)${RESET}"
  echo -e "${DIM}  • Memory store  (mcp__claude-flow__memory_store, memory_search, ...)${RESET}"
  echo -e "${DIM}  • Hooks intel   (mcp__claude-flow__hooks_intelligence, ...)${RESET}"
  [[ -n "$HEADROOM_URL" ]] && \
    echo -e "${DIM}  • Headroom proxy: ${HEADROOM_URL}  (compression active)${RESET}"

elif [[ -n "$HEADROOM_URL" ]]; then
  # opencode: no ruflo block - just surface the headroom line
  echo -e "${DIM}  Headroom proxy: ${HEADROOM_URL}  (compression active)${RESET}"
fi
echo ""

# ── Last-mile env re-export ───────────────────────────────────────────────────
if [[ -n "$HEADROOM_URL" ]]; then
  export ANTHROPIC_BASE_URL="$HEADROOM_URL"
  export OPENAI_BASE_URL="${HEADROOM_URL}/v1"
fi

# ── Graphify: optional knowledge graph refresh (runs after header) ────────────
# Runs AFTER the header so the user already knows what's launching.
# Adds --add-dir graphify-out/ to TOOL_ARGS for Claude (read-only, no-op for opencode).
if [[ $GRAPH -eq 1 ]]; then
  if command -v graphify >/dev/null 2>&1; then
    echo -e "${YELLOW}▶ Refreshing knowledge graph...${RESET}"
    ( cd "$PROJECT_DIR" && graphify update . --no-cluster ) && \
      echo -e "${GREEN}✓ Knowledge graph updated - graphify-out/ ready${RESET}" || \
      echo -e "${YELLOW}⚠ graphify update failed - continuing without graph${RESET}"
    if [[ "$TOOL" == claude && -d "${PROJECT_DIR}/graphify-out" ]]; then
      TOOL_ARGS+=("--add-dir" "${PROJECT_DIR}/graphify-out")
    fi
    echo ""
  else
    echo -e "${YELLOW}⚠ --graph: graphify not found - skipping (install: pipx install graphifyy)${RESET}" >&2
  fi
fi

# ── Launch ────────────────────────────────────────────────────────────────────
if [[ "$TOOL" == claude ]]; then
  # claude's positional is [prompt] not [dir] - cwd (already cd'd) is enough
  exec claude ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"}
else
  # opencode takes a genuine directory positional
  exec opencode "$PROJECT_DIR" ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"}
fi
