#!/usr/bin/env sh
set -e

start=$(date +%s)

pnpm exec lint-staged --concurrent false
pnpm typecheck
pnpm exec prettier --check .
node scripts/check-env-example.mjs
shellcheck bin/lupe-start .husky/pre-commit .husky/pre-push .husky/commit-msg

end=$(date +%s)
echo "pre-commit OK en $((end - start))s"
