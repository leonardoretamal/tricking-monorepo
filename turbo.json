{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "format": {},
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
